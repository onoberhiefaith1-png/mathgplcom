# Copy to .env on the server (cp .env.example .env), fill in, then: chmod 600 .env
# Never commit .env. Placeholders only below.

# --- Domains (A records to the server's public IP, DNS only, no proxy) ---
# Signalling + server API for the app: wss://${LK_DOMAIN}
LK_DOMAIN=livekit.example.com
# Built-in TURN (TURN/TLS through port 443, TURN/UDP on 3478)
LK_TURN_DOMAIN=turn.example.com

# --- LiveKit API key pair (make your own; see README "Make the API key") ---
# Key: any short id starting with API. Secret: at least 32 random characters.
LIVEKIT_API_KEY=APIchangeme
LIVEKIT_API_SECRET=change-me-to-a-long-random-secret-at-least-32-chars

# --- Optional recording (egress, start with --profile recording) ---
# Any S3-compatible bucket. Examples:
#   Cloudflare R2:     EGRESS_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  EGRESS_S3_REGION=auto
#   Supabase Storage:  EGRESS_S3_ENDPOINT=https://<PROJECT_REF>.supabase.co/storage/v1/s3  EGRESS_S3_REGION=<project region, e.g. eu-west-2>
EGRESS_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
EGRESS_S3_REGION=auto
EGRESS_S3_BUCKET=mathemagine-recordings
EGRESS_S3_ACCESS_KEY=
EGRESS_S3_SECRET=
